# Copie este arquivo para .env e preencha com seus valores
# cp .env.example .env

# --- Configuração do provider ---
PROXMOX_VE_SSH_KNOWN_HOSTS_FILE="/dev/null"

# --- Autenticação Proxmox ---
TF_VAR_proxmox_endpoint="https://192.168.122.42:8006/"
TF_VAR_proxmox_api_token="terraform@pve!mytoken=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
TF_VAR_proxmox_insecure="true"

# --- SSH (usado pelo provider para operações de disco) ---
TF_VAR_proxmox_host="192.168.122.42"
TF_VAR_proxmox_ssh_user="root"
TF_VAR_proxmox_ssh_port="22"
TF_VAR_proxmox_ssh_private_key="~/.ssh/id_ed25519"

# --- Infraestrutura ---
TF_VAR_proxmox_node="pve"
TF_VAR_iso_datastore="local"
TF_VAR_disk_datastore="local-lvm"
TF_VAR_network_bridge="vmbr0"

# --- Container ---
TF_VAR_container_id="100"
TF_VAR_container_hostname="ubuntu-container"
TF_VAR_container_tags='["ubuntu", "24.04", "terraform"]'
TF_VAR_feature_nesting="false"

# --- Rede do Container ---
# Obrigatório usar IP fixo para o remote-exec funcionar
TF_VAR_container_ip="192.168.1.100/24"
TF_VAR_container_gateway="192.168.1.1"
TF_VAR_dns_servers='["1.1.1.1", "8.8.8.8"]'
# TF_VAR_dns_domain="home.lab"

# --- Recursos ---
TF_VAR_cpu_cores="1"
TF_VAR_memory_mb="512"
TF_VAR_swap_mb="512"
TF_VAR_disk_size_gb="8"

# --- Acesso ---
# ssh_keys: chave pública do root (deve corresponder a proxmox_ssh_private_key)
TF_VAR_ssh_keys='["ssh-ed25519 AAAAC3... seu-comentario"]'

# --- Usuário do container ---
TF_VAR_container_user="seu-usuario"
TF_VAR_user_ssh_keys='["ssh-ed25519 AAAAC3... seu-comentario"]'
